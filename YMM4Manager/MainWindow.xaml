<Window x:Class="YMM4Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YMM4Manager"
        Title="YMM4 マネージャー" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        Background="{StaticResource Bg}" FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左のメニュー ===== -->
        <Border Background="{StaticResource Side}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,22,16,20">
                    <TextBlock Text="YMM4" FontSize="13" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                    <TextBlock Text="マネージャー" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,18">
                    <TextBlock Text="{Binding RunningText}" Style="{StaticResource SubText}" Margin="6,0,0,10"/>
                    <Button Style="{StaticResource AccentBtn}" Padding="14,11" Command="{Binding LaunchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="YMM4を起動" Foreground="White" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="ホーム"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=home}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8B9;" Content="素材データベース"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=materials}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8B7;" Content="プロジェクト"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=projects}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA86;" Content="プラグイン"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=plugins}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="プラグイン設定"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=pluginsettings}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEDA2;" Content="専用ストレージ"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=storage}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="YMM4プリセット"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=presets}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8A9;" Content="YMM4テンプレート"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=ymm4templates}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8BD;" Content="AI質問"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=ai}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE777;" Content="バックアップ"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=backup}"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="設定"
                                 IsChecked="{Binding Page, Converter={StaticResource PageCheck}, ConverterParameter=settings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <!-- ===== はじめに: YMM4の場所 ===== -->
            <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=setup}">
                <Border Style="{StaticResource CardBox}" MaxWidth="620" VerticalAlignment="Center" Padding="34,30">
                    <StackPanel>
                        <TextBlock Text="ようこそ" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SubText}" FontSize="13" Margin="0,0,0,22"
                                   Text="はじめに、YMM4(ゆっくりMovieMaker4)のフォルダーを選んでください。YukkuriMovieMaker.exe が入っているフォルダーです。"/>
                        <Button Style="{StaticResource AccentBtn}" Padding="18,12" Click="PickYmm4_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="YMM4のフォルダーを選ぶ" Foreground="White" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Content="自動で探す" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding AutoDetectCommand}"/>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,18,0,0"
                                   Text="YMM4を起動している時は、「自動で探す」で、その場所を見つけられます。YukkuriMovieMaker.exe そのものや、その1つ上のフォルダーを選んでも大丈夫です。"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== ホーム ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=home}">
                <StackPanel Margin="34,30,34,30" DataContext="{Binding}">
                    <TextBlock Text="ホーム" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding Ymm4Dir}" Style="{StaticResource SubText}"/>
                    <TextBlock Text="{Binding Ymm4Version}" Style="{StaticResource SubText}" Margin="0,0,0,20"/>

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Border Style="{StaticResource CardBox}" Margin="0,0,10,10" Cursor="Hand" MouseLeftButtonUp="GoMaterials_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                                <TextBlock Text="素材データベース" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Home.MaterialSummary}" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="5,0,5,10" Cursor="Hand" MouseLeftButtonUp="GoPlugins_Click">
                            <StackPanel>
                                <TextBlock Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                                <TextBlock Text="プラグイン" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Home.PluginSummary}" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="10,0,0,10" Cursor="Hand" MouseLeftButtonUp="GoBackup_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                                <TextBlock Text="バックアップ" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="YMM4の設定・プラグイン・素材をまとめて保存" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="最近のプロジェクト" FontWeight="SemiBold" FontSize="15"/>
                                <Button Style="{StaticResource Btn}" Content="すべて見る" HorizontalAlignment="Right" Padding="10,4"
                                        Command="{Binding NavigateCommand}" CommandParameter="projects"/>
                            </Grid>
                            <TextBlock Text="{Binding Home.ProjectSummary}" Style="{StaticResource SubText}"/>
                            <ItemsControl ItemsSource="{Binding Home.Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Btn}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="14,9"
                                                Command="{Binding DataContext.Home.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="クリックすると、YMM4で開きます">
                                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <StackPanel Margin="0,0,40,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <WrapPanel>
                            <Button Style="{StaticResource Btn}" Content="YMM4のフォルダーを開く" Margin="0,0,8,0" Command="{Binding OpenYmmFolderCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="プラグインのフォルダーを開く" Margin="0,0,8,0" Command="{Binding Plugins.OpenRootCommand}"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 素材データベース ===== -->
            <Grid DataContext="{Binding Materials}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=materials}"
                  AllowDrop="True" Drop="Materials_Drop" DragOver="Materials_DragOver">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <!-- 左: 絞り込み -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}">
                    <StackPanel Margin="14,20,14,20">
                        <TextBlock Text="種類" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{x:Static local:MaterialsVm.Kinds}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavItem}" Margin="0" Padding="0" GroupName="MatKind" Content="{Binding Label}" FontSize="13"
                                                 Tag="" Checked="MatKind_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="フォルダー" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding FolderChoices}" SelectedValuePath="Key"
                                 SelectedValue="{Binding FolderFilter}" ItemContainerStyle="{StaticResource RowItem}" Margin="0,0,0,6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="このフォルダーを削除" Click="RemoveMatFolder_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Field}" Tag="新しいフォルダー" Text="{Binding NewFolder, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE710;" Command="{Binding AddFolderCommand}" ToolTip="フォルダーを作る"/>
                        </Grid>

                        <TextBlock Text="色で探す" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{x:Static local:MaterialsVm.ColorPresets}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="24" Height="24" Margin="0,0,5,5" Cursor="Hand" ToolTip="この色に近い素材を探す"
                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12" Background="{Binding Converter={StaticResource HexBrush}}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Btn}" Content="色の絞り込みを外す" Padding="8,4" Margin="0,0,0,16" HorizontalAlignment="Left"
                                Command="{Binding SetColorCommand}" Visibility="{Binding HasColorFilter, Converter={StaticResource B2V}}"/>

                        <TextBlock Text="タグ" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding TagChoices}" SelectedValuePath="Key"
                                 SelectedValue="{Binding TagFilter}" ItemContainerStyle="{StaticResource RowItem}" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Style="{StaticResource Btn}" Content="絞り込みをすべて外す" Margin="0,14,0,0" Command="{Binding ClearFiltersCommand}"/>
                        <CheckBox Style="{StaticResource Check}" Content="ゴミ箱を見る" Margin="0,16,0,0" IsChecked="{Binding ShowTrash}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 中央: 一覧 -->
                <Grid Grid.Column="1" Margin="16,16,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" Tag="名前・タグ・メモで検索" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{x:Static local:MaterialsVm.Sorts}" SelectedValuePath="Key"
                                  SelectedValue="{Binding Sort}" DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
                        <Slider Grid.Column="2" Width="110" Minimum="90" Maximum="320" Value="{Binding TileSize}" VerticalAlignment="Center" Margin="10,0"
                                ToolTip="一覧の大きさ"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{StaticResource AccentBtn}" Content="＋ 取り込む" Click="ImportFiles_Click"/>
                            <Button Style="{StaticResource Btn}" Content="フォルダーごと" Margin="6,0,0,0" Click="ImportFolder_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="MaterialList" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource TileItem}" SelectionChanged="MaterialList_SelectionChanged"
                             MouseDoubleClick="MaterialList_DoubleClick" PreviewMouseLeftButtonDown="MaterialList_MouseDown" PreviewMouseMove="MaterialList_MouseMove"
                             VirtualizingPanel.IsVirtualizing="True" KeyDown="MaterialList_KeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Grid Height="{Binding DataContext.ThumbHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Border Background="{StaticResource Bg}" CornerRadius="6"/>
                                        <TextBlock Text="{Binding KindGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource Sub}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasThumb, Converter={StaticResource NotB2V}}"/>
                                        <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Stars}" Foreground="#FFC940" FontSize="11" Margin="6,4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Margin="2,6,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Info}" Style="{StaticResource SubText}" FontSize="11" Margin="2,1,2,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="開く" Command="{Binding OpenFileCommand}"/>
                                <MenuItem Header="エクスプローラーで表示" Command="{Binding ShowInExplorerCommand}"/>
                                <MenuItem Header="場所をコピー" Command="{Binding CopyPathCommand}"/>
                                <Separator/>
                                <MenuItem Header="ゴミ箱へ" Command="{Binding TrashCommand}"/>
                                <MenuItem Header="ゴミ箱から戻す" Command="{Binding RestoreCommand}"/>
                                <MenuItem Header="完全に削除" Command="{Binding DeleteForeverCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="素材がありません。ファイルをここへドロップするか、「＋ 取り込む」で追加してください" Style="{StaticResource SubText}"
                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}"/>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource SubText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ImportText}" Style="{StaticResource SubText}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource DangerBtn}" Content="ゴミ箱を空にする" Padding="10,3" Command="{Binding EmptyTrashCommand}"
                                    Visibility="{Binding ShowTrash, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 右: 詳しい情報 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}">
                    <StackPanel Margin="16,18,16,18">
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource SubText}" Margin="0,0,0,10"/>
                        <StackPanel Visibility="{Binding HasSingle, Converter={StaticResource B2V}}">
                            <Border Background="{StaticResource Bg}" CornerRadius="8" Height="170" Margin="0,0,0,10">
                                <Grid>
                                    <Image Source="{Binding CurrentPreview}" Stretch="Uniform" Margin="4"/>
                                    <MediaElement x:Name="MatMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" x:Name="MatPlayBar">
                                <Button Style="{StaticResource Btn}" Content="▶ 再生" Padding="10,4" Click="MatPlay_Click" x:Name="MatPlayBtn"/>
                                <Button Style="{StaticResource Btn}" Content="■" Padding="10,4" Margin="6,0,0,0" Click="MatStop_Click"/>
                            </StackPanel>
                            <TextBlock Text="名前" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding EditName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding CurrentInfo}" Style="{StaticResource SubText}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding CurrentPalette}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="26" Height="18" CornerRadius="4" Margin="0,0,4,4" Background="{Binding Converter={StaticResource HexBrush}}" ToolTip="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="メモ" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding EditMemo, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" VerticalContentAlignment="Top" Margin="0,0,0,10"/>
                            <TextBlock Text="URL" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding EditUrl, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding CurrentFolder, StringFormat=フォルダー: {0}}" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                            <TextBlock Text="評価" Style="{StaticResource SubText}" Margin="0,4,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource Btn}" Content="なし" Padding="8,3" Command="{Binding SetRatingCommand}" CommandParameter="0"/>
                                <Button Style="{StaticResource Btn}" Content="★" Padding="8,3" Margin="4,0,0,0" Foreground="#FFC940" Command="{Binding SetRatingCommand}" CommandParameter="1"/>
                                <Button Style="{StaticResource Btn}" Content="★★" Padding="8,3" Margin="4,0,0,0" Foreground="#FFC940" Command="{Binding SetRatingCommand}" CommandParameter="2"/>
                                <Button Style="{StaticResource Btn}" Content="★★★" Padding="8,3" Margin="4,0,0,0" Foreground="#FFC940" Command="{Binding SetRatingCommand}" CommandParameter="3"/>
                                <Button Style="{StaticResource Btn}" Content="5" Padding="8,3" Margin="4,0,0,0" Foreground="#FFC940" Command="{Binding SetRatingCommand}" CommandParameter="5" ToolTip="★5"/>
                            </StackPanel>
                            <TextBlock Text="タグ" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding CurrentTags}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" CornerRadius="12" Padding="10,3,4,3" Margin="0,0,5,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StringFormat=#{0}}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="9" Padding="5,3" ToolTip="このタグを外す"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Field}" Tag="タグを追加(スペースで区切って複数)" Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewTag_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE710;" Command="{Binding AddTagCommand}"/>
                            </Grid>
                            <TextBlock Text="フォルダーへ移す" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding FolderChoices}" DisplayMemberPath="Label" SelectionChanged="MoveFolder_SelectionChanged" Margin="0,0,0,14"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn}" Content="開く" Margin="0,0,6,6" Command="{Binding OpenFileCommand}"/>
                                <Button Style="{StaticResource Btn}" Content="場所を表示" Margin="0,0,6,6" Command="{Binding ShowInExplorerCommand}"/>
                                <Button Style="{StaticResource Btn}" Content="場所をコピー" Margin="0,0,6,6" Command="{Binding CopyPathCommand}"/>
                                <Button Style="{StaticResource DangerBtn}" Content="ゴミ箱へ" Margin="0,0,6,6" Command="{Binding TrashCommand}"/>
                                <Button Style="{StaticResource Btn}" Content="ゴミ箱から戻す" Margin="0,0,6,6" Command="{Binding RestoreCommand}"/>
                                <Button Style="{StaticResource DangerBtn}" Content="完全に削除" Margin="0,0,6,6" Command="{Binding DeleteForeverCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,16,0,0"
                                   Text="素材は、YMM4のタイムラインへドラッグして配置できます。YMM4の中の YmmExplorer プラグインの素材データベースと、同じ中身です。"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== プロジェクト ===== -->
            <Grid DataContext="{Binding Projects}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=projects}" Margin="34,30,34,20"
                  AllowDrop="True" Drop="Projects_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="プロジェクト" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="登録したフォルダーの中の YMM4 プロジェクト(.ymmp)を、新しい順に並べます。ダブルクリックで、YMM4で開きます。" Style="{StaticResource SubText}" Margin="0,0,0,14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource Btn}" Padding="14,9" Margin="0,0,8,0" Click="ImportProject_Click"
                                    ToolTip="手元の .ymmp を、新しいプロジェクトと同じ形(作るフォルダー\名前\名前.ymmp)にコピーして取り込みます。この画面へドロップしても取り込めます">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="プロジェクトファイルを追加"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentBtn}" Padding="16,9" Command="{Binding ShowCreateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="新しいプロジェクトを作る" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- 新しいプロジェクト: 名前の入力欄 -->
                    <Border Style="{StaticResource CardBox}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            Visibility="{Binding IsCreating, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="新しいプロジェクト" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Text="プロジェクト名" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="NewProjectName" Style="{StaticResource Field}" FontSize="15" Tag="例: 第12回 ○○解説"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewProjectName_KeyDown"
                                     IsVisibleChanged="NewProjectName_IsVisibleChanged"/>
                            <TextBlock Text="{Binding NewPathPreview, StringFormat=作る場所: {0}}" Style="{StaticResource SubText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding TemplateText}" Style="{StaticResource SubText}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CreateError}" Foreground="{StaticResource Danger}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasCreateError, Converter={StaticResource B2V}}"/>
                            <CheckBox Style="{StaticResource Check}" Content="作ったら、YMM4で開く" IsChecked="{Binding OpenAfterCreate}" Margin="0,10,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentBtn}" Content="作る" Padding="22,7" Command="{Binding CreateCommand}"/>
                                <Button Style="{StaticResource Btn}" Content="やめる" Margin="8,0,0,0" Command="{Binding CancelCreateCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardBox}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="探すフォルダー" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource Btn}" Content="＋ フォルダーを追加" HorizontalAlignment="Right" Padding="10,4" Click="AddProjectFolder_Click"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding}" Style="{StaticResource SubText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" ToolTip="登録から外す"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <TextBox Style="{StaticResource Field}" Tag="名前で検索" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" Width="360"/>
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Files}" ItemContainerStyle="{StaticResource RowItem}"
                         MouseDoubleClick="ProjectList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource SubText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource SubText}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubText}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AccentBtn}" Content="開く" Padding="12,5"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE838;" Margin="4,0,0,0" ToolTip="フォルダーを開く"
                                            Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" ToolTip="コピーをバックアップへ保存"
                                            Command="{Binding DataContext.BackupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="プロジェクトが見つかりません。「＋ フォルダーを追加」で、プロジェクトを保存しているフォルダーを登録してください" Style="{StaticResource SubText}"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoFiles, Converter={StaticResource B2V}}"/>
            </Grid>

            <!-- ===== プラグイン ===== -->
            <Grid DataContext="{Binding Plugins}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=plugins}" Margin="34,30,34,20"
                  AllowDrop="True" Drop="Plugins_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="プラグイン" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="YMM4に入れているプラグインの有効・無効の切り替え・削除・追加ができます。変更は、YMM4を再起動すると反映されます。" Style="{StaticResource SubText}"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource SubText}" Margin="0,4,0,10"/>
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,12" Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="プリセット" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Width="320" ItemsSource="{Binding PresetChoices}" SelectedItem="{Binding Target, Mode=TwoWay}" VerticalAlignment="Center"
                                          ToolTip="どの YMM4 プリセットのプラグインを管理するか(いま使っていないプリセットも選べます)"/>
                                <TextBlock Text="{Binding PluginRoot}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TargetText}" Style="{StaticResource SubText}" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="コピー先" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Width="320" ItemsSource="{Binding CopyTargets}" SelectedItem="{Binding CopyTarget, Mode=TwoWay}" VerticalAlignment="Center"
                                          ToolTip="選ぶと、各プラグインの「コピー」で、そのプリセットへ同じプラグインを入れられます"/>
                                <Button Style="{StaticResource Btn}" Content="すべてコピー先へ" Margin="8,0,0,0" Command="{Binding CopyAllToCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource AccentBtn}" Content="＋ プラグインを入れる(.ymme / .zip / .dll)" Margin="0,0,8,0" Click="InstallPlugin_Click"/>
                        <Button Style="{StaticResource Btn}" Content="フォルダーを開く" Margin="0,0,8,0" Command="{Binding OpenRootCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="読み込み直す" Command="{Binding ReloadCommand}"/>
                    </WrapPanel>
                </StackPanel>
                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource SubText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubText}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn}" Content="{Binding ToggleText}" Padding="10,5"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource Btn}" Content="コピー" Padding="10,5" Margin="4,0,0,0" ToolTip="「コピー先」のプリセットへ、このプラグインをコピーします"
                                            Command="{Binding DataContext.CopyToCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE838;" Margin="4,0,0,0" ToolTip="場所を開く"
                                            Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="削除"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ===== プラグイン設定(YmmExplorer の設定) ===== -->
            <Grid DataContext="{Binding PluginSettings}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=pluginsettings}" Margin="34,30,34,20">
                <Grid.Resources>
                    <!-- 一覧・組み合わせの設定を、入力欄で編集する(中の一覧も、同じ形で入れ子に表示) -->
                    <DataTemplate DataType="{x:Type local:JsonEditNode}">
                        <StackPanel>
                            <!-- まだ設定していない -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsUnset, Converter={StaticResource B2V}}">
                                <TextBlock Text="(初期設定のまま)" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource Btn}" Content="自分で設定する" Padding="10,3" Margin="10,0,0,0" Command="{Binding CreateCommand}"/>
                            </StackPanel>
                            <DockPanel Margin="0,1" Visibility="{Binding IsUnset, Converter={StaticResource NotB2V}}">
                                <!-- 右: 並べ替え・削除 -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74A;" FontSize="11" ToolTip="上へ" Command="{Binding MoveUpCommand}"
                                            Visibility="{Binding CanMoveUp, Converter={StaticResource B2V}}"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="11" ToolTip="この行を消す" Command="{Binding RemoveCommand}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                                <!-- 左: 番号・名前 -->
                                <TextBlock DockPanel.Dock="Left" Text="{Binding IndexText}" Style="{StaticResource SubText}" Width="26" VerticalAlignment="Center"
                                           Visibility="{Binding ShowIndex, Converter={StaticResource B2V}}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding KeyLabel}" Width="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"
                                           Visibility="{Binding ShowKey, Converter={StaticResource B2V}}"/>
                                <StackPanel DockPanel.Dock="Left" Width="170" Margin="0,0,8,0" Visibility="{Binding KeyEditable, Converter={StaticResource B2V}}">
                                    <TextBox Style="{StaticResource Field}" Text="{Binding Key, UpdateSourceTrigger=LostFocus}" ToolTip="名前(キー)"/>
                                    <TextBlock Text="{Binding KeyHint}" Style="{StaticResource SubText}" FontSize="10"/>
                                </StackPanel>
                                <!-- 値 -->
                                <StackPanel>
                                    <CheckBox Style="{StaticResource Check}" Content="オン" IsChecked="{Binding BoolValue}" Visibility="{Binding IsBool, Converter={StaticResource B2V}}"/>
                                    <DockPanel Visibility="{Binding IsValue, Converter={StaticResource B2V}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{StaticResource Accent}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasHint, Converter={StaticResource B2V}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource Field}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <Border Visibility="{Binding IsContainer, Converter={StaticResource B2V}}" BorderBrush="{StaticResource Stroke}" BorderThickness="2,0,0,0" Padding="10,2,0,2">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Children}"/>
                                            <Button Style="{StaticResource Btn}" Content="{Binding AddText}" Padding="10,3" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                    Command="{Binding AddCommand}" Visibility="{Binding CanAdd, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="プラグイン設定(YmmExplorer)" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap"
                               Text="YmmExplorer のすべての設定を、ここで変えられます。変えた項目には ● が付き、「保存」を押すと書き込みます。YMM4 を起動している時は、YMM4 を再起動すると反映されます(YMM4 を閉じてから保存するのが確実です)。"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource SubText}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="320"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" Tag="項目を検索(名前・説明)" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="1" Width="180" Margin="8,0,0,0" ItemsSource="{Binding Groups}" SelectedItem="{Binding Group, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <WrapPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource Check}" Content="未保存の変更だけ" IsChecked="{Binding ChangedOnly}" Margin="0,0,14,0"/>
                            <CheckBox Style="{StaticResource Check}" Content="初期値から変えた項目だけ" IsChecked="{Binding CustomizedOnly}"/>
                        </WrapPanel>
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding View}" Margin="0,0,8,0">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="2,16,0,6"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="380"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- 一覧・組み合わせ: 入力欄で(横幅いっぱい) -->
                                        <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Content="{Binding Tree}" Focusable="False"
                                                        Visibility="{Binding IsTree, Converter={StaticResource B2V}}"/>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource SubText}" TextWrapping="Wrap" Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Key}" Foreground="{StaticResource Sub}" FontSize="10" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Warn}" FontSize="10" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="10" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 値の入力(種類ごと) -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource Check}" Content="オン" IsChecked="{Binding BoolValue}" Visibility="{Binding IsBool, Converter={StaticResource B2V}}"/>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay}" Visibility="{Binding IsChoice, Converter={StaticResource B2V}}"/>
                                            <TextBox Style="{StaticResource Field}" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsLine, Converter={StaticResource B2V}}"/>
                                            <TextBox Style="{StaticResource Field}" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRaw, Converter={StaticResource B2V}}"
                                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" MinHeight="34" MaxHeight="180"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                     ToolTip="一覧や組み合わせの設定です。JSON の形で書きます(空にすると、初期設定に戻ります)"/>
                                            <DockPanel Visibility="{Binding IsSecret, Converter={StaticResource B2V}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerBtn}" Content="消す" Padding="10,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.ClearSecretCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding SecretText}" Style="{StaticResource SubText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <ToggleButton Style="{StaticResource Chip}" Content="{}{ } JSON" FontSize="10" Margin="0,0,4,0" IsChecked="{Binding RawMode}"
                                                          ToolTip="JSON の文字で直接編集する(慣れている人向け)" Visibility="{Binding IsJson, Converter={StaticResource B2V}}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE777;" ToolTip="初期値に戻す"
                                                    Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn}" Content="表示中の項目を初期値に" Margin="0,0,8,0" Command="{Binding ResetGroupCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="設定フォルダーを開く" Margin="0,0,8,0" Command="{Binding OpenFolderCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="読み込み直す" Margin="0,0,8,0" Command="{Binding ReloadCommand}"/>
                            <Button Style="{StaticResource AccentBtn}" Content="保存" Padding="22,6" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ChangedText}" VerticalAlignment="Center" Foreground="{StaticResource Warn}"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== YMM4専用ストレージ ===== -->
            <ScrollViewer DataContext="{Binding Storage}" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=storage}">
                <StackPanel Margin="34,30,34,20" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock Text="YMM4専用ストレージ" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="ドライブ(外付けの SSD など)やフォルダーを YMM4 専用に登録して、YMM4本体・素材データベース・プロジェクト・バックアップ・過去のバージョンを、すべてその中にまとめられます。"/>

                    <!-- 登録 -->
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="専用ストレージの場所" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding RootText}" FontSize="15" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SpaceText}" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                            <ProgressBar Height="6" Maximum="1" Value="{Binding UsedRatio, Mode=OneWay}" Margin="0,6,0,12" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                         Visibility="{Binding IsReachable, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="ドライブを選ぶ(そのドライブに「YMM4」フォルダーを作ります)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <ComboBox Width="420" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" Margin="0,0,8,6" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="ドライブの一覧を読み直す" Margin="0,0,8,6" Command="{Binding RefreshDrivesCommand}"/>
                                <Button Style="{StaticResource AccentBtn}" Content="このドライブを専用にする" Margin="0,0,8,6" Command="{Binding UseDriveCommand}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource Btn}" Content="フォルダーを選んで専用にする…" Margin="0,0,8,0" Click="StorageFolder_Click"/>
                                <Button Style="{StaticResource Btn}" Content="開く" Margin="0,0,8,0" Command="{Binding OpenCommand}"
                                        Visibility="{Binding IsRegistered, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource DangerBtn}" Content="登録を外す" Command="{Binding UnregisterCommand}"
                                        Visibility="{Binding IsRegistered, Converter={StaticResource B2V}}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 素材フォルダー・丸ごとバックアップ -->
                    <Grid Margin="0,0,0,14" Visibility="{Binding IsRegistered, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="素材フォルダー" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,6"
                                           Text="専用ストレージの「素材」フォルダーに入れた画像・動画・音声は、YMM4 の AIエディットの AI がいつも見られて、操作の提案でタイムラインに配置できます。"/>
                                <TextBlock Text="{Binding MaterialsText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource AccentBtn}" Content="素材フォルダーを開く" HorizontalAlignment="Left" Command="{Binding OpenMaterialsCommand}"/>

                                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                                <TextBlock Text="録画フォルダー" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,6"
                                           Text="ゲームの録画などを自由に入れておく場所です。録画ソフトの保存先をここにしておくと便利です。AIエディットの AI からも見えて、配置を提案できます。"/>
                                <TextBlock Text="{Binding RecordingsText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource AccentBtn}" Content="録画フォルダーを開く" HorizontalAlignment="Left" Command="{Binding OpenRecordingsCommand}"/>

                                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                                <TextBlock Text="立ち絵フォルダー" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,6"
                                           Text="キャラクターの立ち絵(画像や、パーツに分かれた立ち絵素材)を入れておく場所です。キャラクターごとにフォルダーを分けると分かりやすくなります。YMM4 のキャラクター設定で、立ち絵の場所にここを選んでください。AIエディットの AI からも見えます。"/>
                                <TextBlock Text="{Binding PortraitsText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource AccentBtn}" Content="立ち絵フォルダーを開く" HorizontalAlignment="Left" Command="{Binding OpenPortraitsCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="定期バックアップ(丸ごとコピー)" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="決めたフォルダーへ、決めた間隔で、専用ストレージの中身をすべてコピーします。保存先は、専用ストレージとは別のドライブがおすすめです。"/>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="選ぶ…" Padding="10,4" Margin="6,0,0,0" Click="StorageBackup_Click"/>
                                    <TextBlock Text="{Binding BackupDir, StringFormat=保存先: {0}}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="☁ クラウドストレージに入れる(Dropbox・OneDrive・Google ドライブなど)" FontWeight="SemiBold"/>
                                        <DockPanel Margin="0,6,0,4" Visibility="{Binding HasClouds, Converter={StaticResource B2V}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="ここに保存する" Margin="6,0,0,0" Command="{Binding UseCloudCommand}"/>
                                            <ComboBox ItemsSource="{Binding CloudChoices}" SelectedItem="{Binding SelectedCloud, Mode=TwoWay}" DisplayMemberPath="Label"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="探し直す" Padding="8,2" Margin="6,0,0,0" Command="{Binding FindCloudsCommand}" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding CloudNote}" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <ComboBox ItemsSource="{Binding IntervalChoices}" SelectedIndex="{Binding IntervalIndex, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding KeepChoices}" SelectedIndex="{Binding KeepIndex, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Style="{StaticResource Check}" Content="ZIP 1つにまとめる(クラウド向け。ファイルが多くても同期が速い)" IsChecked="{Binding BackupZip}" Margin="0,0,0,4"/>
                                <CheckBox Style="{StaticResource Check}" Content="中の「バックアップ」フォルダーは除く" IsChecked="{Binding ExcludeBackups}" Margin="0,0,0,4"/>
                                <CheckBox Style="{StaticResource Check}" Content="マネージャーを開いていない時もバックアップする(Windows のタスクスケジューラー)" IsChecked="{Binding UseTask}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding NextText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LastText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button Style="{StaticResource AccentBtn}" Content="今すぐバックアップ" HorizontalAlignment="Left" Command="{Binding BackupCommand}"/>

                                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                                <TextBlock Text="バックアップから戻す" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="選んだバックアップの状態に、専用ストレージをまるごと戻します(あとから足したファイルは消え、変えたファイルは元に戻ります)。YMM4 を閉じてから行ってください。"/>
                                <TextBlock Text="(保存先にバックアップがまだありません)" Style="{StaticResource SubText}" Margin="0,0,0,6" Visibility="{Binding HasBackupPoints, Converter={StaticResource NotB2V}}"/>
                                <ComboBox ItemsSource="{Binding BackupPoints}" SelectedItem="{Binding SelectedPoint, Mode=TwoWay}" Margin="0,0,0,6"
                                          Visibility="{Binding HasBackupPoints, Converter={StaticResource B2V}}"/>
                                <CheckBox Style="{StaticResource Check}" Content="戻す前に、今の状態も保存先に残す(おすすめ)" IsChecked="{Binding KeepBeforeRestore}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource DangerBtn}" Content="この状態に戻す" HorizontalAlignment="Left" Command="{Binding RestoreCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 入れるもの -->
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding IsRegistered, Converter={StaticResource B2V}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="まだのものを、すべてここへ移す" Command="{Binding MoveAllCommand}"/>
                        <TextBlock Text="専用ストレージに入れるもの" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsRegistered, Converter={StaticResource B2V}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBox}" Margin="0,0,0,8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubText}" Margin="10,1,0,0"/>
                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Accent}" Margin="10,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CurrentText, StringFormat=いまの場所: {0}}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE838;" ToolTip="場所を開く" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource AccentBtn}" Content="ここへ移す" Visibility="{Binding CanMove, Converter={StaticResource B2V}}"
                                                    Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding IsRegistered, Converter={StaticResource B2V}}"
                               Text="※ 移す時は YMM4 を閉じてください。同じドライブの中なら一瞬で、ちがうドライブなら中身をコピーしてから元の場所を片付けます。YMM4本体を移したあとは、デスクトップなどのショートカットを作り直してください。"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== YMM4プリセット ===== -->
            <Grid DataContext="{Binding Presets}" Margin="34,30,34,20"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=presets}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="YMM4プリセット" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap"
                               Text="YMM4 を、user フォルダー(設定・キャラクター・プラグイン)ごと複製して、いくつも持てます。動画のシリーズごと・試したいプラグインごとなどに分けて、切り替えたり、そのまま起動したりできます。"/>
                    <TextBlock Text="{Binding PresetRoot, StringFormat=複製の保存先: {0}(専用ストレージを登録すると、その中の「YMM4プリセット」)}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Style="{StaticResource AccentBtn}" Content="＋ いまの YMM4 を複製してプリセットを作る" Margin="0,0,8,6" Command="{Binding StartCopyCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="いまの YMM4 をそのまま別の場所へコピー…" Margin="0,0,8,6" Click="PresetCopyTo_Click"/>
                        <Button Style="{StaticResource Btn}" Content="すでにある YMM4 を登録…" Margin="0,0,8,6" Click="PresetAdd_Click"/>
                    </WrapPanel>
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,10" Visibility="{Binding IsNaming, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="新しいプリセットの名前" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="やめる" Margin="8,0,0,0" Command="{Binding CancelCopyCommand}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="複製する" Margin="8,0,0,0" Command="{Binding CopyCommand}"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" KeyDown="PresetName_KeyDown" Tag="例: ゲーム実況用"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="560"/></Grid.ColumnDefinitions>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MinWidth="220" FontWeight="SemiBold" ToolTip="名前(クリックして変えられます)"/>
                                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding PluginText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding Memo, UpdateSourceTrigger=LostFocus}" Tag="メモ(何用の YMM4 か など)" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource AccentBtn}" Content="使う・管理する" Margin="0,0,6,0" Visibility="{Binding CanUse, Converter={StaticResource B2V}}"
                                            ToolTip="マネージャーの起動ボタン・プラグイン・アップデートなどの対象を、この YMM4 にします"
                                            Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource Btn}" Content="起動" Margin="0,0,6,0"
                                            Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE838;" ToolTip="場所を開く"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="一覧から外す(フォルダーも消すか選べます)"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 右: いまのプリセットの管理 -->
                <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="18,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding CurrentTitle}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,10"
                                       Text="ほかのプリセットを管理する時は、左の「使う・管理する」を押してください。素材データベース・YmmExplorer の設定・プロジェクト・専用ストレージは、すべてのプリセットで共有です。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Style="{StaticResource Chip}" GroupName="PresetPanel" Content="バージョン" Margin="0,0,6,0"
                                             IsChecked="{Binding Panel, Converter={StaticResource PageCheck}, ConverterParameter=version}"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="PresetPanel" Content="プラグイン" Margin="0,0,6,0"
                                             IsChecked="{Binding Panel, Converter={StaticResource PageCheck}, ConverterParameter=plugins}"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="PresetPanel" Content="ユーザー設定"
                                             IsChecked="{Binding Panel, Converter={StaticResource PageCheck}, ConverterParameter=user}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <!-- バージョン -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Panel, Converter={StaticResource PageVis}, ConverterParameter=version}">
                        <StackPanel DataContext="{Binding DataContext.Updater, RelativeSource={RelativeSource AncestorType=Window}}">
                            
                            <TextBlock Text="{Binding CurrentVersion, StringFormat=いまのバージョン: {0}}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,10"
                                       Text="変える前に、今のバージョンをこのPCに保存するので、いつでも戻せます。user フォルダー(設定・キャラクター・プラグイン)は変えません。YMM4を閉じてから行ってください。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="版" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="160" ItemsSource="{Binding Editions}" SelectedIndex="{Binding EditionIndex, Mode=TwoWay}"
                                          ToolTip="このプリセットが通常版か Lite 版か(アップデートで入れる版が変わります)"/>
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource AccentBtn}" Content="最新版にアップデート" Margin="0,0,8,6" Command="{Binding UpdateLatestCommand}"/>
                                <Button Style="{StaticResource Btn}" Content="バージョンの一覧を読み込む" Margin="0,0,8,6" Command="{Binding CheckCommand}"/>
                                <Button Style="{StaticResource Btn}" Content="ダウンロードした zip から入れる" Margin="0,0,8,6" Click="InstallYmmZip_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource Accent}" Background="{StaticResource Card}" BorderThickness="0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="取りやめ" Padding="10,3" Margin="10,0,0,0" Command="{Binding CancelCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Releases}" MaxHeight="420">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="12,8" Margin="0,0,0,5">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Info}" Style="{StaticResource SubText}"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource Btn}" Content="このバージョンにする" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4"
                                                        Background="{StaticResource Panel}"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                                                </ScrollViewer>

                            <!-- プラグイン -->
                            <DockPanel DataContext="{Binding DataContext.Plugins, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.Panel, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource PageVis}, ConverterParameter=plugins}"
                                       AllowDrop="True" Drop="Plugins_Drop">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="このプリセットの user\plugin に入っているプラグインです。プリセットごとに別々に入れられます(YMM4 の再起動で反映)。" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Style="{StaticResource AccentBtn}" Content="＋ プラグインを入れる" Margin="0,0,8,4" Click="InstallPlugin_Click"/>
                                        <Button Style="{StaticResource Btn}" Content="フォルダーを開く" Margin="0,0,8,4" Command="{Binding OpenRootCommand}"/>
                                        <Button Style="{StaticResource Btn}" Content="読み込み直す" Margin="0,0,8,4" Command="{Binding ReloadCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource RowItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource SubText}"><Run Text="{Binding StateText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Btn}" Content="{Binding ToggleText}" Padding="8,4"
                                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="削除"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- ユーザー設定 -->
                            <StackPanel Visibility="{Binding Panel, Converter={StaticResource PageVis}, ConverterParameter=user}">
                                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="YMM4 の設定・キャラクター・ショートカットなどは、プリセットごとの user フォルダーに入っていて、プリセットごとに別々です。"/>
                                <TextBlock Text="{Binding UserInfo}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource Btn}" Content="user フォルダーを開く" HorizontalAlignment="Left" Margin="0,0,0,16" Command="{Binding OpenUserCommand}"/>
                                <TextBlock Text="ほかのプリセットの設定を取り込む(プラグインは除く)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="260" ItemsSource="{Binding UserSources}" SelectedItem="{Binding CopySource, Mode=TwoWay}" DisplayMemberPath="Name"/>
                                    <Button Style="{StaticResource AccentBtn}" Content="取り込む" Margin="8,0,0,0" Command="{Binding CopyUserCommand}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="取り込む前の設定は、同じプリセットの中に「user_取り込み前_日時」として残します。"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
                </Grid>
            </Grid>

            <!-- ===== YMM4テンプレート(YMM4 標準のテンプレート) ===== -->
            <Grid DataContext="{Binding Ymm4Templates}" Margin="34,30,34,20"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=ymm4templates}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="YMM4テンプレート" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap"
                               Text="YMM4 標準のテンプレート(タイムラインのアイテムを右クリック →「テンプレートに保存」したもの)を、プリセットごとに管理します。名前の変更・削除・書き出し・読み込み・ほかのプリセットへのコピーができます。"/>
                    <Border Style="{StaticResource CardBox}" Margin="0,10,0,10" Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="プリセット" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Width="320" ItemsSource="{Binding PresetChoices}" SelectedItem="{Binding Target, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE838;" ToolTip="設定ファイルの場所を開く" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FileText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Style="{StaticResource Btn}" Content="すべて選ぶ / 外す" Margin="0,0,8,6" Command="{Binding CheckAllCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="選んだものを書き出す…" Margin="0,0,8,6" Command="{Binding ExportCommand}"/>
                        <Button Style="{StaticResource Btn}" Content="読み込む…" Margin="0,0,8,6" Command="{Binding ImportCommand}"/>
                        <Button Style="{StaticResource DangerBtn}" Content="選んだものを削除" Margin="0,0,16,6" Command="{Binding DeleteCommand}"/>
                        <TextBlock Text="コピー先" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <ComboBox Width="220" ItemsSource="{Binding CopyTargets}" SelectedItem="{Binding CopyTarget, Mode=TwoWay}" Margin="0,0,8,6" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Btn}" Content="選んだものをコピー" Margin="0,0,8,6" Command="{Binding CopyToCommand}"/>
                    </WrapPanel>
                </StackPanel>
                <Grid Grid.Row="1">
                    <TextBlock Text="テンプレートがありません" Style="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}"/>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBox Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MinWidth="260" HorizontalAlignment="Left" FontWeight="SemiBold" ToolTip="名前(クリックして変えられます)"/>
                                        <TextBlock Text="{Binding InfoText}" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn}" Content="読み込み直す" Margin="0,0,8,0" Command="{Binding ReloadCommand}"/>
                            <Button Style="{StaticResource AccentBtn}" Content="保存" Padding="22,6" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DirtyText}" Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   ToolTip="YMM4 は閉じる時に設定を書き込むため、YMM4 を閉じてから保存してください"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== AI質問 ===== -->
            <Grid DataContext="{Binding Ai}" Loaded="AiPage_Loaded" AllowDrop="True" PreviewDragOver="Ai_DragOver" PreviewDrop="Ai_Drop"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=ai}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 上: AI の選択 -->
                <Border Background="{StaticResource Panel}" Padding="24,14,24,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn}" Content="新しい会話" Margin="0,0,6,0" Command="{Binding NewChatCommand}"/>
                            <ToggleButton Style="{StaticResource Chip}" Content="会話の履歴" Margin="0,0,6,0" IsChecked="{Binding ShowHistory}"
                                          ToolTip="これまでの会話(YMM4専用ストレージの「AI会話」に保存)を開いて、続きから話せます"/>
                            <ToggleButton Style="{StaticResource Chip}" Content="⚙ 設定" IsChecked="{Binding ShowSettings}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AI質問" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ComboBox Width="220" ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <ComboBox Width="240" Margin="8,0,0,0" IsEditable="True" ItemsSource="{Binding ModelChoices}" Text="{Binding Model, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                      ToolTip="使うモデル(YMM4 の中の AIエディットと共通)"/>
                            <TextBlock Text="{Binding ModelBadge}" ToolTip="{Binding ModelNote}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding HasModelNote, Converter={StaticResource B2V}}"/>
                            <CheckBox Style="{StaticResource Check}" Content="🌐 ネット検索" IsChecked="{Binding WebOn}" VerticalAlignment="Center" Margin="14,0,0,0"
                                      Visibility="{Binding IsLocalStudio, Converter={StaticResource B2V}}"
                                      ToolTip="オンにすると、Local AI Studio が必要な時にインターネットを検索して、ページを読んだ結果を AI に渡します(最新の情報・使い方・URL の中身など)"/>
                            <Button Style="{StaticResource Btn}" Content="Local AI Studio を開く" Margin="10,0,0,0" Command="{Binding OpenLocalStudioCommand}"
                                    ToolTip="モデルのインストール・性能と重さの確認は、Local AI Studio の「モデルライブラリ」で"
                                    Visibility="{Binding IsLocalStudio, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- 設定 -->
                <Border Grid.Row="1" Background="{StaticResource Side}" Padding="24,12" Visibility="{Binding ShowSettings, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="APIキー(YMM4 の中の AIエディットと共通。このPCで暗号化して保存します)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <PasswordBox x:Name="AiKeyBox" Width="360" Padding="8,6" Background="{StaticResource Card}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Stroke}"/>
                            <Button Style="{StaticResource AccentBtn}" Content="保存" Margin="8,0,0,0" Click="AiSaveKey_Click"/>
                            <Button Style="{StaticResource Btn}" Content="キーを取得するページ" Margin="8,0,0,0" Command="{Binding OpenKeyPageCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="モデルの一覧を読む" Margin="8,0,0,0" Command="{Binding FetchModelsCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding KeyState}" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsCompatible, Converter={StaticResource B2V}}">
                            <TextBlock Text="URL" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Field}" Width="360" Text="{Binding BaseUrl, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <TextBlock Text="AI の記憶" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding UseMemory}" Margin="0,0,0,4"
                                  Content="これまでの会話を覚えておく(ほかのプロジェクト・YmmExplorer の AIエディットの会話も。YMM4専用ストレージの「AI記憶」に保存)"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerBtn}" Content="すべて忘れる" Margin="6,0,0,0" Command="{Binding ClearMemoryCommand}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="記憶を開く" Command="{Binding OpenMemoryCommand}"/>
                            <TextBlock Text="{Binding MemoryInfo}" Style="{StaticResource SubText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="質問と一緒に送るもの" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <CheckBox Style="{StaticResource Check}" Content="専用ストレージのすべての中身(AI が必要なファイルを読みます)" IsChecked="{Binding SendStorage}" Margin="0,0,16,4"/>
                            <CheckBox Style="{StaticResource Check}" Content="素材データベース" IsChecked="{Binding SendMaterials}" Margin="0,0,16,4"/>
                            <CheckBox Style="{StaticResource Check}" Content="プロジェクトの一覧" IsChecked="{Binding SendProjects}" Margin="0,0,16,4"/>
                            <CheckBox Style="{StaticResource Check}" Content="YMM4 の情報(バージョン・プラグイン)" IsChecked="{Binding SendYmm4}" Margin="0,0,16,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- 会話の履歴 -->
                <Grid Grid.Row="2" Panel.ZIndex="1" Background="{StaticResource Bg}" Visibility="{Binding ShowHistory, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="24,12,24,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="保存先を開く" Command="{Binding OpenChatFolderCommand}"/>
                        <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{Binding ChatFolder, StringFormat=会話は自動で保存しています({0})。YMM4 の中の AIエディットの会話も、ここから続けられます。}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="まだ保存した会話はありません" Style="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource B2V}}"/>
                    <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding History}" ItemContainerStyle="{StaticResource RowItem}" Margin="20,0,20,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding InfoText}" Style="{StaticResource SubText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Style="{StaticResource AccentBtn}" Content="続きから話す" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ContinueChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="削除"
                                                Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 会話 -->
                <ScrollViewer x:Name="AiScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,10">
                    <StackPanel MaxWidth="980">
                        <StackPanel Visibility="{Binding HasNoMessages, Converter={StaticResource B2V}}" Margin="0,30,0,0">
                            <TextBlock Text="YMM4 や素材・プロジェクトのことを、AI に質問できます" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding QuickPrompts}" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Btn}" Content="{Binding}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.QuickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Border x:Name="bubble" Background="{StaticResource Card}" CornerRadius="10" Padding="14,10" HorizontalAlignment="Stretch">
                                            <StackPanel>
                                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                         Foreground="{StaticResource Text}" FontSize="13"/>
                                                <TextBlock Text="{Binding Attached, StringFormat=📎 一緒に送ったもの: {0}}" Style="{StaticResource SubText}" FontSize="11" Margin="0,6,0,0"
                                                           Visibility="{Binding HasAttached, Converter={StaticResource B2V}}"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Style="{StaticResource Btn}" Content="コピー" Padding="8,2" FontSize="11" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Visibility="{Binding IsAssistant, Converter={StaticResource B2V}}"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="bubble" Property="Background" Value="{StaticResource AccentDark}"/>
                                            <Setter TargetName="bubble" Property="Margin" Value="80,0,0,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="bubble" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            <Setter TargetName="bubble" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <!-- 入力 -->
                <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="24,10,24,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="📎 ファイル" Padding="10,4" Margin="0,0,8,0" Click="AiAttach_Click"
                                    ToolTip="画像・テキスト・字幕・プロジェクト(.ymmp)を送れます。ここへドラッグ&amp;ドロップでも"/>
                            <TextBlock DockPanel.Dock="Left" Text="プロジェクトの中身を読ませる:" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox DockPanel.Dock="Left" Width="240" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding Project, Mode=TwoWay}" DisplayMemberPath="Name" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="プロジェクトを外す" Command="{Binding ClearProjectCommand}"
                                    Visibility="{Binding HasProject, Converter={StaticResource B2V}}"/>
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" CornerRadius="10" Padding="8,2,2,2" Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                                <Button Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="9" Padding="4,2" ToolTip="外す"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="44" MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     PreviewKeyDown="AiInput_PreviewKeyDown" Tag="質問を入力(Enter で送信 / Shift+Enter で改行)"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource Btn}" Content="取りやめ" Margin="0,0,0,6" Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource AccentBtn}" Content="送信" Padding="22,10" Command="{Binding SendCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CurrentAi}" Style="{StaticResource SubText}" FontSize="11" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== バックアップ ===== -->
            <ScrollViewer DataContext="{Binding Backups}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=backup}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,30,34,20">
                    <TextBlock Text="バックアップ" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="YMM4の設定やプラグインなどを、ZIPファイルにまとめて保存します。何かあった時に、その時の状態へ戻せます。" Style="{StaticResource SubText}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="保存するもの" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IncludeWholeYmm4}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="YMM4のフォルダーまるごと" FontWeight="SemiBold"/>
                                    <Run Text="(本体・設定・プラグイン・辞書など、すべて。大きくなります)" Foreground="{StaticResource Sub}"/>
                                </TextBlock>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Check}" Content="YMM4の設定(user\setting)" IsChecked="{Binding IncludeYmmSettings}" IsEnabled="{Binding PartsEnabled}" Margin="20,0,0,8"/>
                            <CheckBox Style="{StaticResource Check}" Content="プラグイン(user\plugin)" IsChecked="{Binding IncludePlugins}" IsEnabled="{Binding PartsEnabled}" Margin="20,0,0,8"/>
                            <CheckBox Style="{StaticResource Check}" Content="YmmExplorer の設定・テンプレート・プリセットなど" IsChecked="{Binding IncludeExplorer}"/>
                            <CheckBox Style="{StaticResource Check}" Content="素材データベース(素材のファイルも。大きくなることがあります)" IsChecked="{Binding IncludeMaterials}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource AccentBtn}" Content="今すぐバックアップ" Command="{Binding CreateCommand}"/>
                                <TextBlock Text="{Binding Progress}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BackupRoot, StringFormat=保存先: {0}}" Style="{StaticResource SubText}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="保存したバックアップ" FontWeight="SemiBold" Margin="0,4,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Info}" Style="{StaticResource SubText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn}" Content="この状態に戻す" Padding="10,5"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE838;" Margin="4,0,0,0" ToolTip="場所を開く"
                                                    Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="削除"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 設定 ===== -->
            <ScrollViewer Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=settings}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,30,34,20" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="設定" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="YMM4の場所" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Ymm4Dir}" Style="{StaticResource SubText}"/>
                            <TextBlock Text="{Binding Ymm4Version}" Style="{StaticResource SubText}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Style="{StaticResource AccentBtn}" Content="場所を選ぶ" Margin="0,0,8,0" Click="PickYmm4_Click"/>
                                <Button Style="{StaticResource Btn}" Content="自動で探す" Margin="0,0,8,0" Command="{Binding AutoDetectCommand}"/>
                                <Button Style="{StaticResource Btn}" Content="フォルダーを開く" Command="{Binding OpenYmmFolderCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- YMM4のバージョン(YMM4プリセットのページへ移しました) -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="YMM4のバージョン・Lite 版・プラグイン" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="アップデート・以前のバージョンに戻す・Lite 版の切り替え・プラグインは、「YMM4プリセット」のページで、プリセットごとに管理します。"/>
                            <Button Style="{StaticResource AccentBtn}" Content="YMM4プリセットを開く" HorizontalAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="presets"/>
                        </StackPanel>
                    </Border>

                    <!-- プロジェクト -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel DataContext="{Binding Projects}">
                            <TextBlock Text="新しいプロジェクト" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ProjectRoot, StringFormat=作るフォルダー: {0}}" Style="{StaticResource SubText}"/>
                            <TextBlock Text="新しいプロジェクトは「このフォルダー \ プロジェクト名 \ プロジェクト名.ymmp」の形で作ります。" Style="{StaticResource SubText}" Margin="0,2,0,8"/>
                            <TextBlock Text="{Binding TemplateText}" Style="{StaticResource SubText}"/>
                            <TextBlock Text="ひな形が無い時は、いちばん新しいプロジェクトの設定(解像度・fps・キャラクターなど)で、空のプロジェクトを作ります。" Style="{StaticResource SubText}" Margin="0,2,0,10"/>
                            <WrapPanel>
                                <Button Style="{StaticResource AccentBtn}" Content="作るフォルダーを選ぶ" Margin="0,0,8,6" Click="PickProjectRoot_Click"/>
                                <Button Style="{StaticResource Btn}" Content="ひな形を選ぶ(.ymmp)" Margin="0,0,8,6" Click="PickTemplate_Click"/>
                                <Button Style="{StaticResource Btn}" Content="ひな形を使わない" Margin="0,0,8,6" Click="ClearTemplate_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBox}">
                        <StackPanel DataContext="{Binding Materials}">
                            <TextBlock Text="素材データベースの保存先" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding LibraryPath}" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBlock Text="YMM4の中の YmmExplorer プラグインと、同じ保存先を使います。どちらで変えても、もう片方に反映されます。" Style="{StaticResource SubText}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn}" Content="別の保存先を開く" Margin="0,0,8,0" Click="OpenLibrary_Click"/>
                                <Button Style="{StaticResource Btn}" Content="保存先を引っ越す" Margin="0,0,8,0" Click="MoveLibrary_Click"/>
                                <Button Style="{StaticResource Btn}" Content="サムネイル・色を作り直す" Command="{Binding RebuildThumbsCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="バックアップの保存先" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Backups.BackupRoot}" Style="{StaticResource SubText}" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource Btn}" Content="変更する" HorizontalAlignment="Left" Click="PickBackupDir_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="通知領域(タスクバーの右下)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox Style="{StaticResource Check}" Content="通知領域にアイコンを出す(押すと開きます。右クリックで YMM4 の起動・今すぐバックアップ・終了)" IsChecked="{Binding TrayIcon}" Margin="0,0,0,4"/>
                            <CheckBox Style="{StaticResource Check}" Content="× で閉じた時は終わらずに、通知領域に残す(定期バックアップを続けます)" IsChecked="{Binding CloseToTray}"
                                      IsEnabled="{Binding TrayIcon}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap"
                                       Text="アイコンが「隠れているインジケーター」(∧ の中)に入った時は、タスクバーへドラッグすると、いつも見える所に出せます。"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="このソフトについて" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AppVersion, StringFormat=YMM4 マネージャー {0}}" Style="{StaticResource SubText}"/>
                            <TextBlock Text="設定の保存先: %AppData%\YMM4Manager" Style="{StaticResource SubText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 下の通知 ===== -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Background="{StaticResource Card}" CornerRadius="10" Padding="18,10"
                    MaxWidth="760" Visibility="{Binding HasToast, Converter={StaticResource B2V}}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.4"/>
                </Border.Effect>
                <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
